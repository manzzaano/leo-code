!.leo-code/.gitignore

# Sidecar cache
sidecar/cache/
cache/

# Temp
tmp/
logs/
*.log
_find_*.py
_output_*.txt
benchmark_run.log

# Local dev
leo-code-dev

# Worktrees aislados (superpowers:using-git-worktrees)
.worktrees/

# build artifacts de los wheels de packaging
packaging/*/dist/
packaging/*/build/
packaging/*/*.egg-info/

# artefactos de cobertura / auditoría
.coverage
cov.json
_no_docstring_*.txt
benchmark/.oc_empty_config/
opencode.json.bench_bak

# Corridas sueltas de benchmark (ruido): solo summary.json se trackea
benchmark/results_real/*.json
!benchmark/results_real/summary.json
