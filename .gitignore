*.egg
dist/
build/
.eggs/
*.so

# Virtualenv
.venv/
venv/
env/

# Env
.env
.env.local

# IDE
.idea/
.vscode/
.codex/
.serena/

# CodeGraph index (runtime database)
.codegraph/

# OS
.DS_Store
Thumbs.db
nul

# OpenCode config (local dev tool)
.leo-code/
